# Copia este archivo como `.env` para ajustar la configuración local.
# Todas las variables son opcionales.

# Proveedor de datos inicial:
#   demo         flota simulada (sin conexión)
#   auto         multi-red: adsb.lol + ADSB.one + adsb.fi + airplanes.live + Flightradar24
#   fr24         feed global de Flightradar24 (JSONP, incluye ruta y matrícula)
#   adsblol | adsbone | adsbfi | airplaneslive | opensky
VITE_ADSB_PROVIDER=auto

# Tamaño de la flota simulada al arrancar (250, 600 o 1200). Sólo afecta a `demo`.
VITE_FLEET_SIZE=600

# Endpoint de glifos para las etiquetas de matrícula/callsign del mapa.
# VITE_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# Ruta base del build (necesaria si despliegas en un subdirectorio distinto).
# En producción el workflow de GitHub Pages la define automáticamente.
# VITE_BASE_PATH=/FrameFR/

# Token de Cesium ion para la fotogrametría 3D opcional del visor.
# Cuenta gratuita (sin tarjeta) en https://ion.cesium.com: añade el asset
# «Google Photorealistic 3D Tiles» a My Assets y crea un token con assets:read.
# También se puede pegar dentro de la app: Ajustes › Rendimiento.
# VITE_CESIUM_ION_TOKEN=
