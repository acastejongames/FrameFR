# Copia este archivo como `.env` para ajustar la configuración local.
# Todas las variables son opcionales.

# Proveedor de datos inicial: `demo` (flota simulada) o `adsblol` (feed público en directo).
VITE_ADSB_PROVIDER=demo

# Tamaño de la flota simulada al arrancar (250, 600 o 1200).
VITE_FLEET_SIZE=600

# Endpoint de glifos para las etiquetas de matrícula/callsign del mapa.
# VITE_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf

# Ruta base del build (necesaria si despliegas en un subdirectorio distinto).
# VITE_BASE_PATH=/FrameFR/
