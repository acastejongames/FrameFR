{
  "name": "framefr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FrameFR — seguimiento de tráfico aéreo en tiempo real sobre un mapa interactivo (React + TypeScript + Vite + MapLibre GL)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "smoke": "vite build --config smoke.config.ts --logLevel error && node dist-smoke/smoke.js"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
